# Copy this file to .env and fill in real values. Never commit .env.
#
# Required for LLM inference (Groq free developer tier).
GROQ_API_KEY=

# Required for filing/document embedding storage (Pinecone free tier).
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Required by SEC EDGAR: identify your requests with a real contact.
# Format recommended by SEC: "<App Name> <contact email>"
SEC_USER_AGENT="agentic-financial-planner you@example.com"

# Optional overrides.
GROQ_MODEL=llama-3.1-70b-versatile
EQUITY_RESEARCH_DB_PATH=./data/equity_research.db
EQUITY_RESEARCH_HTTP_CACHE_DIR=./data/http_cache
